# ==============================================================================
# ImpactLens AI — Root .gitignore
# ==============================================================================

# Environment variable files (SECRETS)
.env
.env.*
.env.local
.env.development.local
.env.test.local
.env.production.local

# DO NOT ignore example templates
!.env.example
!.env*.example

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
.venv/
ENV/
*.db
*.sqlite3

# Node & Next.js
node_modules/
.next/
out/
build/
dist/
.DS_Store
*.pem
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
.vercel

# Local media uploads & scratch files
backend/uploads/*
!backend/uploads/.gitkeep
