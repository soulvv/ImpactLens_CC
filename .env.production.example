# ==============================================================================
# ImpactLens AI — Production Environment Reference
#
# This file is documentation only. It is NEVER loaded at runtime.
# Production secrets are set in the platform dashboards:
#
#   Backend  -> Render  -> impactlens-api -> Environment
#   Frontend -> Vercel  -> Project -> Settings -> Environment Variables
#
# Do NOT create a .env.production file containing real secrets, and never
# commit one. Both platforms read configuration from the dashboard.
# ==============================================================================


# ==============================================================================
# 1. FRONTEND (Vercel) — browser-safe
# ==============================================================================
# Set in Vercel for Production, Preview AND Development.
#
# This MUST be the deployed backend URL, not localhost. NEXT_PUBLIC_ values
# are inlined into the client JavaScript bundle at BUILD time, so changing
# this variable in the dashboard requires a REDEPLOY to take effect.
NEXT_PUBLIC_API_URL=https://impactlens-api.onrender.com


# ==============================================================================
# 2. BACKEND (Render) — server-side only, never exposed to the browser
# ==============================================================================

# --- Application core ---
PROJECT_NAME="ImpactLens AI"
API_V1_STR="/api"
ENVIRONMENT=production
DEBUG=false

# --- Database (REQUIRED) ---
# Neon or Supabase connection string. Do NOT rely on the SQLite fallback:
# it writes to the ephemeral container disk and is silently wiped on every
# redeploy. Verify /health reports "engine": "postgresql" after deploying.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DBNAME

# --- Cloudinary (REQUIRED in production) ---
# Unset => uploads land on ephemeral container disk and 404 after redeploy.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Google Gemini (REQUIRED for real AI analysis) ---
# Unset => analysis degrades to offline ecological heuristics.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# --- OmniDimension voice assistant (optional) ---
# Blank => embedded local fallback voice.
OMNIDIM_API_KEY=
OMNIDIM_AGENT_ID=
OMNIDIM_BASE_URL=https://omnidim.io/api/v1

# --- CORS (REQUIRED) ---
# Comma-separated list of allowed frontend origins. Read once at startup,
# so updating it later requires a redeploy. Use your Vercel domain, e.g.
# https://impactlens.vercel.app
# Never use "*" alongside allow_credentials=True.
CORS_ORIGINS=https://impactlens.vercel.app

# --- FFmpeg video pipeline (Phase 3.5) ---
# Intentionally NOT set on Render's native Python runtime: no ffmpeg binary
# can be installed there. Leaving these unset lets shutil.which() return None
# so VideoService degrades cleanly:
#   - metadata:  ffprobe -> HTTP/Cloudinary URL heuristics
#   - keyframes: local ffmpeg -> Cloudinary so_<seconds> frame serving
# Cloudinary frame extraction still returns real JPEGs per timestamp, so
# Phase 3.5 stays functional. Set these ONLY if you move to a runtime that
# ships ffmpeg (e.g. Render's Docker runtime).
# FFMPEG_PATH=ffmpeg
# FFPROBE_PATH=ffprobe
VIDEO_MAX_ANALYSIS_DURATION_SECONDS=180
VIDEO_MAX_FRAMES=8


# ==============================================================================
# 3. NOT NEEDED IN PRODUCTION
# ==============================================================================
# backend/run.py          dev-only: hardcodes reload=True and port=8000.
#                         Render injects $PORT; render.yaml's startCommand uses it.
# scripts/check_env.py    local config audit.
# backend/seed_*.py       dev seeding. Not shipped in the Docker image.
# frontend/.env.local     local dev only. Vercel injects its own values.
