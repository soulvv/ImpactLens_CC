# ==============================================================================
# ImpactLens AI — Frontend Environment Configuration
# ==============================================================================
# Copy this file to frontend/.env.local for local Next.js development.
# CRITICAL SECURITY RULE:
# NEVER place server secrets (Gemini keys, Cloudinary secrets, OmniDimension keys,
# database credentials) in frontend environment variables.
# All NEXT_PUBLIC_* variables are bundled into browser JavaScript!
# ==============================================================================

# Backend FastAPI service URL
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000
