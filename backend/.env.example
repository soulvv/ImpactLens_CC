# ==============================================================================
# ImpactLens AI — Backend Environment Configuration Template
# ==============================================================================
# Copy this file to backend/.env and populate with your credentials.
# CRITICAL: Never commit .env files containing real secrets to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. APPLICATION SETTINGS
# ------------------------------------------------------------------------------
# Project metadata & environment controls
PROJECT_NAME="ImpactLens AI"
API_V1_STR="/api"
ENVIRONMENT=development
DEBUG=true

# ------------------------------------------------------------------------------
# 2. DATABASE CONFIGURATION
# ------------------------------------------------------------------------------
# Primary PostgreSQL connection string (Async/Sync SQLAlchemy compatible)
# Format: postgresql://<user>:<password>@<host>:<port>/<database>
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/impactlens_db

# ------------------------------------------------------------------------------
# 3. CLOUDINARY MEDIA STORAGE (SERVER-SIDE ONLY)
# ------------------------------------------------------------------------------
# Required for production image/video hosting and secure CDN delivery.
# If omitted, local disk storage fallback (/backend/uploads) will be used.
# Obtain from: https://cloudinary.com/console
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ------------------------------------------------------------------------------
# 4. GOOGLE GEMINI AI (SERVER-SIDE ONLY)
# ------------------------------------------------------------------------------
# Multimodal analysis for images, video scene interpretation, semantic embeddings,
# and before/after ecological comparison reasoning.
# Obtain from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
# Canonical multimodal model (default: gemini-1.5-flash)
GEMINI_MODEL=gemini-1.5-flash

# ------------------------------------------------------------------------------
# 5. OMNIDIMENSION VOICE ASSISTANT (SERVER-SIDE ONLY)
# ------------------------------------------------------------------------------
# Voice agent integration for conversational environmental media intelligence.
# Server uses API key to mint short-lived voice session tokens for the browser.
# Obtain from: https://omnidimension.ai dashboard
OMNIDIM_API_KEY=
OMNIDIM_AGENT_ID=
OMNIDIM_BASE_URL=https://api.omnidimension.ai/v1

# ------------------------------------------------------------------------------
# 6. CORS ALLOWED ORIGINS
# ------------------------------------------------------------------------------
# Comma-separated list of allowed frontend origins (no trailing slashes)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ------------------------------------------------------------------------------
# 7. VIDEO & FFMPEG PROCESSING (PHASE 3.5)
# ------------------------------------------------------------------------------
# Name or absolute path to ffmpeg and ffprobe executables on your system
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe

# Maximum video duration to process for keyframe sampling (in seconds)
VIDEO_MAX_ANALYSIS_DURATION_SECONDS=180

# Maximum number of representative keyframes to sample per video
VIDEO_MAX_FRAMES=8
