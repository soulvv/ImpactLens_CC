# ==============================================================================
# ImpactLens AI — Backend .gitignore
# ==============================================================================

# Environment files containing backend secrets
.env
.env.*
.env.local
.env.development
.env.production

# DO NOT ignore example template
!.env.example

# Python cache & build
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
dist/
build/
.pytest_cache/
.coverage
htmlcov/

# Virtual environments
venv/
.venv/
env/

# Database files
*.db
*.sqlite3

# Local uploads
uploads/*
!uploads/.gitkeep
