# ==============================================================================
# ImpactLens AI — Master Environment Configuration Template
# ==============================================================================
# This template documents all environment variables across backend and frontend.
#
# QUICK START:
# 1. Backend:  Copy to backend/.env and populate credentials
# 2. Frontend: Copy to frontend/.env.local (only requires NEXT_PUBLIC_API_URL)
# ==============================================================================

# ==============================================================================
# 1. FRONTEND CONFIGURATION (BROWSER-SAFE)
# ==============================================================================
# Located in: frontend/.env.local
# Backend API base URL accessible from user browser
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000

# ==============================================================================
# 2. BACKEND CONFIGURATION (SERVER-SIDE ONLY — NEVER EXPOSE TO CLIENT)
# ==============================================================================
# Located in: backend/.env

# Application Core Settings
PROJECT_NAME="ImpactLens AI"
API_V1_STR="/api"
ENVIRONMENT=development
DEBUG=true

# Database (PostgreSQL required)
# Format: postgresql://<user>:<password>@<host>:<port>/<database>
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/impactlens_db

# Cloudinary Media Storage (Server-only credentials)
# Obtain from: https://cloudinary.com/console
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Google Gemini AI Engine (Server-only credentials)
# Obtain from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# OmniDimension Voice Assistant (Server-only credentials)
# Obtain from: https://omnidimension.ai
OMNIDIM_API_KEY=
OMNIDIM_AGENT_ID=
OMNIDIM_BASE_URL=https://api.omnidimension.ai/v1

# CORS Allowed Origins (Comma-separated list)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Video & Keyframe Pipeline (FFmpeg)
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
VIDEO_MAX_ANALYSIS_DURATION_SECONDS=180
VIDEO_MAX_FRAMES=8
